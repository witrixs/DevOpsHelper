# Production → /opt/devopshelper/.env
# JWT_SECRET_KEY on prod must differ from local.
# If you change APP_PORT — update nginx proxy_pass.

APP_NAME=DevOpsHelper
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
WEB_DIST=web/dist

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devops_db

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
