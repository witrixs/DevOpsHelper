# Application
APP_NAME=DevOpsHelper
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
WEB_DIST=web/dist

# PostgreSQL 18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devops_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Promote this username to admin on API startup (optional)
BOOTSTRAP_ADMIN_USERNAME=

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
